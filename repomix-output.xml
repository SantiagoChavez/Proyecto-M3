<file path="styles.css">
/* ==========================================
   VARIABLES Y ESTILOS BASE
   ========================================== */
:root {
    --primary-color: #6366f1;
    --primary-hover: #4f46e5;
    --bg-color: #0f172a;
    --card-bg: #1e293b;
    --text-color: #f8fafc;
    --text-muted: #94a3b8;
    --user-msg: #005c4b;
    --char-msg: #202c33;
    --max-width: 1200px;
    /* FIX PROFESOR: Ancho máximo del contenido del header y del chat centrado */
    --max-width-content: 900px; 
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background-color: var(--bg-color);
    color: var(--text-color);
    height: 100vh;
    height: 100dvh; 
    display: flex;
    flex-direction: column;
    overflow: hidden; 
}

#app {
    flex: 1;
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0.5rem;
    display: flex; 
    flex-direction: column;
    min-height: 0; 
}

/* Control de Scroll Independiente para Vistas SPA (About y Home) */
.view-section {
    width: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow-y: auto; 
    box-sizing: border-box;
    padding-bottom: 20px;
}

.view-section::-webkit-scrollbar { width: 6px; }
.view-section::-webkit-scrollbar-track { background: transparent; }
.view-section::-webkit-scrollbar-thumb { background-color: rgba(255, 255, 255, 0.1); border-radius: 10px; }

/* ==========================================
   ESTILOS DEL HEADER (ALINEACIÓN CENTRADA Y FLUIDA)
   ========================================== */
.main-header {
    background-color: var(--card-bg);
    padding: 0.8rem 1.5rem; 
    display: flex;
    justify-content: center; /* Centra el bloque de contenido en PC */
    align-items: center;
    border-bottom: 1px solid #334155;
    flex-shrink: 0; 
}

/* Contenedor interno alineado simétricamente con el cuerpo de la app */
.header-content {
    width: 100%;
    max-width: var(--max-width-content); /* Se planta en 900px en PC */
    display: flex;
    justify-content: space-between; /* Logo a la izquierda, menú a la derecha */
    align-items: center;
    gap: 15px;
}

.logo {
    font-size: 1.2rem; 
    font-weight: bold;
    color: var(--primary-color);
    white-space: nowrap; 
    display: flex;
    align-items: center;
    gap: 6px;
}

.nav-links {
    display: flex;
    gap: 1.2rem; 
}

.nav-item {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
    cursor: pointer;
    transition: color 0.2s ease;
}

.nav-item:hover {
    color: var(--text-color);
}

.nav-item.active {
    color: var(--primary-color);
    font-weight: bold;
}

/* ==========================================
   ESTILOS DEL HOME (DISEÑO BASE GRILLA)
   ========================================== */
.home-section {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1rem;
}

.hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    padding: 1.5rem;
    background-color: var(--card-bg);
    border-radius: 12px;
    border: 1px solid #334155;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
    width: 100%;
}

.characters-grid-responsive {
    display: grid;
    width: 100%;
}

.clickable-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 16px;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s ease;
}

.clickable-card img {
    width: 75px;
    height: 75px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--primary-color);
    margin-bottom: 8px;
    transition: transform 0.2s ease;
}

.clickable-card:hover {
    transform: translateY(-4px);
    border-color: var(--primary-color);
    background-color: rgba(255, 255, 255, 0.08);
}

.warning-text {
    color: #ef4444; 
    font-size: 0.9rem;
}

/* ==========================================
   ESTILOS DEL CHAT (INTERNOS Y CONTENEDORES)
   ========================================== */
.chat-section {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0; 
    gap: 0;
}

.chat-container {
    display: flex;
    flex-direction: column;
    flex: 1; 
    width: 100%;
    max-width: 100%;
    background-color: #0b141a; 
    border: 1px solid #222e35;
    border-radius: 12px;
    overflow: hidden;
    min-height: 0; 
}

.chat-messages {
    flex: 1;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow-y: auto; 
    min-height: 0;
    background-image: url('./assets/Cocina.jpg'); 
    background-size: cover; 
    background-position: center;
    background-repeat: no-repeat;
    background-color: rgba(11, 20, 26, 0.85); 
    background-blend-mode: multiply; 
}

.chat-messages > :first-child {
    margin-top: auto;
}

/* Globitos de mensajes */
.message {
    padding: 8px 12px;
    border-radius: 8px;
    max-width: 75%;
    font-size: 0.95rem;
    box-shadow: 0 1px 1px rgba(0,0,0,0.2);
    word-break: break-word;
}

.user-message {
    background-color: var(--user-msg);
    color: #e9edef;
    align-self: flex-end;
    border-top-right-radius: 0px;
}

.system-message {
    background-color: #182229;
    color: #8696a0;
    align-self: center;
    text-align: center;
    font-size: 0.8rem;
    padding: 6px 12px;
    border-radius: 6px;
    max-width: 90%;
    margin: 5px 0;
}

.character-msg-wrapper {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    align-self: flex-start;
    max-width: 75%;
}

.character-message {
    background-color: var(--char-msg);
    color: #e9edef;
    border-top-left-radius: 0px;
    max-width: 100%; 
}

.character-msg-wrapper img {
    cursor: pointer;
    transition: transform 0.2s ease;
}

.character-msg-wrapper img:hover {
    transform: scale(1.08);
}

/* ANIMACIÓN: INDICADOR ANIMADO DE FLUJO ("ESCRIBIENDO...") */
.typing-indicator {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 10px 14px;
    background-color: var(--char-msg);
    border-radius: 8px;
    border-top-left-radius: 0px;
    display: inline-flex;
}

.typing-indicator span {
    width: 8px;
    height: 8px;
    background-color: #8696a0;
    border-radius: 50%;
    display: inline-block;
    animation: typing-bounce 1.4s infinite ease-in-out both;
}

.typing-indicator span:nth-child(1) { animation-delay: -0.32s; }
.typing-indicator span:nth-child(2) { animation-delay: -0.16s; }

@keyframes typing-bounce {
    0%, 80%, 100% { transform: scale(0); }
    40% { transform: scale(1.0); }
}

/* Área de entrada de texto */
.chat-input-area {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px;
    background-color: #202c33;
    border-top: 1px solid #222e35;
    flex-shrink: 0; 
}

.chat-input-area input {
    flex: 1;
    padding: 11px 16px;
    background-color: #1f2c34;
    border: 1px solid #2a3942;
    border-radius: 8px; 
    color: #e9edef;
    font-size: 0.95rem;
    outline: none;
    transition: all 0.2s ease;
}

.chat-input-area input:focus {
    border-color: var(--primary-color);
    background-color: #2a3942;
}

/* BOTÓN DE ENVIAR GRADIENTE CIRCULAR PREMIUM */
.send-arrow-btn {
    width: 42px;
    height: 42px;
    background: linear-gradient(135deg, var(--primary-color), #4f46e5);
    color: white;
    border: none;
    border-radius: 50%; 
    cursor: pointer;
    font-size: 1.05rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: 2px; 
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3); 
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1); 
    flex-shrink: 0;
}

.send-arrow-btn:hover {
    background: linear-gradient(135deg, #7577f2, var(--primary-hover));
    box-shadow: 0 6px 16px rgba(99, 102, 241, 0.45);
    transform: translateY(-2px) rotate(-5deg);
}

.send-arrow-btn:active {
    transform: translateY(1px) scale(0.92);
    box-shadow: 0 2px 6px rgba(99, 102, 241, 0.2);
}

/* ==========================================
   BOTONES Y ELEMENTOS REUTILIZABLES
   ========================================== */
.btn-primary {
    padding: 10px 20px;
    background-color: var(--primary-color);
    color: white;
    border: none;
    border-radius: 20px; 
    cursor: pointer;
    font-weight: bold;
    font-size: 0.95rem;
    transition: background-color 0.2s ease;
}

.btn-primary:hover {
    background-color: var(--primary-hover);
}

.main-footer {
    background-color: var(--card-bg);
    text-align: center;
    padding: 1rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    border-top: 1px solid #334155;
    flex-shrink: 0; 
}

/* ==========================================
   SELECTOR DROPDOWN PREMIUM (TUNED)
   ========================================== */
.char-dropdown {
    -webkit-appearance: none; /* Elimina la flecha nativa en Chrome, Safari y Opera */
    -moz-appearance: none;    /* Elimina la flecha nativa en Firefox */
    appearance: none;         /* Elimina la flecha nativa estándar */
    
    background-color: #1f2c34;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%236366f1' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpolyline points='6 9 12 15 18 9'%3E%3C/polyline%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 12px center;
    background-size: 16px;
    
    color: #e9edef;
    border: 1px solid #2a3942;
    padding: 8px 36px 8px 12px; /* Espacio a la derecha para no pisar la nueva flecha */
    border-radius: 8px; /* Redondeado idéntico al de tus inputs principales */
    outline: none;
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
}

/* Efecto focus y hover sincronizado con la identidad visual */
.char-dropdown:hover {
    border-color: var(--primary-color);
    background-color: #2a3942;
}

.char-dropdown:focus {
    border-color: var(--primary-color);
    box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.25);
}

/* Estilos para las opciones de adentro del menú desplegable */
.char-dropdown option {
    background-color: #1e293b;
    color: #f8fafc;
    padding: 10px;
}

/* ==========================================
   MEDIA QUERIES INTEGRALES (MOBILE-FIRST ABSOLUTO Y NATIVO)
   ========================================== */

/* --- 1. SMARTPHONES Y CELULARES (Hasta 599px - S8 / iPhone) --- */
@media (max-width: 599px) {
    /* FIX PROFESOR: Ocultamos el texto largo, dejando solo la máscara grande */
    .logo-text {
        display: none;
