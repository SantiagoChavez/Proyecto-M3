    .nav-links {
        gap: 0.8rem;
    }
    
    .nav-item {
        font-size: 0.85rem;
    }
    
    #app {
        padding: 4px;
    }
    
    .home-section .characters-grid-responsive {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }
    
    .clickable-card {
        padding: 12px;
    }
    
    .clickable-card img {
        width: 60px;
        height: 60px;
    }

    .chat-container {
        border-radius: 6px;
    }
}

/* --- 2. TABLETS ESTÁNDAR Y PANTALLAS CHICAS (De 600px a 767px - Nest Hub) --- */
@media (min-width: 600px) and (max-width: 767px) {
    .header-content {
        max-width: 100%;
        padding: 0 10px; 
    }

    .logo {
        font-size: 1.2rem; 
    }
    
