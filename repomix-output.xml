    }

    .chat-container {
        max-width: 90%; 
        height: 72vh;
        margin: 15px auto;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
    }
}

/* --- 3. TABLETS GRANDES Y LAPTOPS COMPACTAS (De 768px a 1023px - ¡iPod Pro / Surface 7!) --- */
/* REPARACIÓN: Escalamos proporcionalmente fuentes y contenedores para alta densidad */
@media (min-width: 768px) and (max-width: 1023px) {
    .header-content {
        max-width: 100%;
        padding: 0 20px; /* Aire simétrico en extremos del cuerpo */
    }

    .logo {
        font-size: 1.4rem; 
    }
    
    .nav-item {
        font-size: 1.15rem; 
        padding: 6px 12px;
    }
    
    /* Forzamos 4 columnas fluidas y balanceadas en la grilla del Home */
    .home-section .characters-grid-responsive {
        grid-template-columns: repeat(4, 1fr);
        gap: 16px; 
        max-width: 850px; 
    }
    
    .clickable-card {
        padding: 16px;
    }
    
    .clickable-card h3 {
        font-size: 1.05rem;
    }
    
    .clickable-card img {
        width: 75px; 
        height: 75px;
    }

    /* Caja de chat con escalado ideal para pantallas de buen tamaño */
    .chat-container {
        max-width: 800px; 
        height: 75vh;
        margin: 20px auto;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
    }
    
    .main-footer {
        font-size: 0.95rem;
        padding: 1.5rem;
    }
}

/* --- 4. MONITORES GRANDES Y PC DESKTOP (Desde 1024px en adelante) --- */
@media (min-width: 1024px) {
    .home-section .characters-grid-responsive {
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        max-width: var(--max-width-content); 
