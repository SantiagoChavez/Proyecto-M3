import { GoogleGenerativeAI } from '@google/generative-ai';

export default async function handler(request, response) {
    // 1. Validamos método POST
    if (request.method !== 'POST') {
        return response.status(405).json({ error: 'Método no permitido. Usar POST.' });
    }

    try {
        // Paracaídas para capturar el body venga como objeto o como string plano
        let body = request.body;
        if (typeof body === 'string') {
            body = JSON.parse(body);
        }

        const { systemPrompt, history } = body || {};

        // Validamos que exista una API Key cargada para que no tire 500 a ciegas
        if (!process.env.GEMINI_API_KEY) {
            console.error("❌ ERROR CRÍTICO: No se encontró la variable GEMINI_API_KEY en el entorno.");
            return response.status(500).json({ error: "Falta la configuración de la API Key en el servidor." });
        }

        // 2. Inicializamos Gemini con la SDK oficial
        const genAI = new GoogleGenerativeAI(process.env.GEMINI_API_KEY);
        const model = genAI.getGenerativeModel({ 
            model: 'gemini-2.5-flash',
            systemInstruction: systemPrompt || "Eres un asistente de Inteligencia Artificial."
        });

        // 3. Mapeamos el historial asegurando un formato plano compatible con Google
        const historialSeguro = Array.isArray(history) ? history : [];
        
        const contents = historialSeguro.map(msg => ({
            role: msg.role === 'user' ? 'user' : 'model',
            parts: [{ text: msg.text || '' }]
        }));

        // Si el historial arrancó vacío, le inyectamos un mensaje inicial para que Google no rebote
        if (contents.length === 0) {
            contents.push({ role: 'user', parts: [{ text: 'Hola' }] });
        }

        // 4. Llamada oficial en vivo a los servidores de Google
        const result = await model.generateContent({
            contents: contents,
            generationConfig: {
                temperature: 0.7,
                maxOutputTokens: 500,
                topK: 40,
                topP: 0.95,
                candidateCount: 1   
            }
        });

        const geminiResponse = await result.response;
        const replyText = geminiResponse.text().trim();

        // 5. Devolvemos la respuesta limpia al Frontend
        return response.status(200).json({ reply: replyText });

    } catch (error) {
        console.error('❌ Error en el Backend:', error);
        return response.status(500).json({ error: 'Error de IA: ' + error.message });
    }
}
