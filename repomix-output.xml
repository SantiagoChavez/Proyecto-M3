        padding: 20px;
    }

    .clickable-card img {
        width: 75px;
        height: 75px;
    }

    .chat-container {
        max-width: var(--max-width-content); 
        height: 70vh;
        margin: 20px auto;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }
}
