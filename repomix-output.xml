<file path="styles.css">
/* ==========================================
   VARIABLES Y ESTILOS BASE
   ========================================== */
:root {
    --primary-color: #6366f1;
    --primary-hover: #4f46e5;
    --bg-color: #0f172a;
    --card-bg: #1e293b;
    --text-color: #f8fafc;
    --text-muted: #94a3b8;
    --user-msg: #005c4b;
    --char-msg: #202c33;
    --max-width: 1200px;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background-color: var(--bg-color);
    color: var(--text-color);
    height: 100vh;
    height: 100dvh; 
    display: flex;
    flex-direction: column;
    overflow: hidden; 
}

#app {
    flex: 1;
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0.5rem;
    display: flex; 
    flex-direction: column;
    min-height: 0; 
}

/* ==========================================
   ESTILOS DEL HEADER
   ========================================== */
.main-header {
    background-color: var(--card-bg);
    padding: 0.8rem 1.5rem; 
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #334155;
    flex-shrink: 0; 
}

.logo {
    font-size: 1.1rem; 
    font-weight: bold;
    color: var(--primary-color);
    white-space: nowrap; 
}

.nav-links {
    display: flex;
    gap: 1.2rem; 
}

.nav-item {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
    cursor: pointer;
}

.nav-item.active {
    color: var(--primary-color);
    font-weight: bold;
}

/* ==========================================
   ESTILOS DEL HOME (GRILLA RESPONSIVA MOBILE-FIRST)
   ========================================== */
.home-section {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1rem;
}

.hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    padding: 1.5rem;
    background-color: var(--card-bg);
    border-radius: 12px;
    border: 1px solid #334155;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
    width: 100%;
}

/* Regla Base Mobile First: Forzamos cuadrícula 2x2 en celulares */
.home-section .characters-grid-responsive {
    grid-template-columns: repeat(2, 1fr);
}

/* Animación sutil de zoom al pasar el mouse por arriba de una card */
.clickable-card:hover {
    transform: translateY(-4px);
    border-color: var(--primary-color);
    background-color: rgba(255, 255, 255, 0.08);
}

.warning-text {
    color: #ef4444; 
    font-size: 0.9rem;
}

/* ==========================================
   ESTILOS DEL CHAT (SELECTOR Y ELEMENTOS INTERNOS)
   ========================================== */
.chat-section {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0; 
    gap: 10px;
}

/* Estilos para el Dropdown selector de personajes */
.character-selector-container {
    background-color: var(--card-bg);
    padding: 10px 15px;
    border-radius: 8px;
    border: 1px solid #334155;
    display: flex;
    align-items: center;
    gap: 10px;
}

.char-dropdown {
    background-color: #2a3942;
    color: #e9edef;
    border: 1px solid #334155;
    padding: 6px 12px;
    border-radius: 6px;
    outline: none;
    font-size: 0.95rem;
    cursor: pointer;
    flex: 1;
}

.chat-container {
    display: flex;
    flex-direction: column;
    flex: 1; 
    width: 100%;
    max-width: 100%;
    background-color: #0b141a; 
    border: 1px solid #222e35;
    border-radius: 12px;
    overflow: hidden;
    min-height: 0; 
}

.chat-messages {
    flex: 1;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow-y: auto; 
    min-height: 0;
    
    background-image: url('./assets/Cocina.jpg'); 
    background-size: cover; 
    background-position: center;
    background-repeat: no-repeat;
    background-color: rgba(11, 20, 26, 0.85); 
    background-blend-mode: multiply; 
}

/* Mantiene los mensajes abajo nativamente */
.chat-messages > :first-child {
    margin-top: auto;
}

/* Globitos de mensajes */
.message {
    padding: 8px 12px;
    border-radius: 8px;
    max-width: 75%;
    font-size: 0.95rem;
    box-shadow: 0 1px 1px rgba(0,0,0,0.2);
    word-break: break-word;
}

.user-message {
    background-color: var(--user-msg);
    color: #e9edef;
    align-self: flex-end;
    border-top-right-radius: 0px;
}

.system-message {
    background-color: #182229;
    color: #8696a0;
    align-self: center;
    text-align: center;
    font-size: 0.8rem;
    padding: 6px 12px;
    border-radius: 6px;
    max-width: 90%;
    margin: 5px 0;
}

.character-msg-wrapper {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    align-self: flex-start;
    max-width: 75%;
}

.chat-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid #222e35;
    flex-shrink: 0; 
}

.character-message {
    background-color: var(--char-msg);
    color: #e9edef;
    border-top-left-radius: 0px;
    max-width: 100%; 
}

/* ANIMACIÓN "CALCIFER ESCRIBIENDO..." */
.typing-indicator {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 12px 16px;
}

.typing-indicator span {
    width: 8px;
    height: 8px;
    background-color: #8696a0;
    border-radius: 50%;
    display: inline-block;
    animation: typing-bounce 1.4s infinite ease-in-out both;
}

.typing-indicator span:nth-child(1) { animation-delay: -0.32s; }
.typing-indicator span:nth-child(2) { animation-delay: -0.16s; }

@keyframes typing-bounce {
    0%, 80%, 100% { transform: scale(0); }
    40% { transform: scale(1.0); }
}

/* Área de entrada */
.chat-input-area {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px;
    background-color: #202c33;
    flex-shrink: 0; 
}

.chat-input-area input {
    flex: 1;
    padding: 10px 16px;
    background-color: #2a3942;
    border: none;
    border-radius: 20px;
    color: #e9edef;
    font-size: 0.95rem;
    outline: none;
}

/* ==========================================
   BOTONES Y ELEMENTOS REUTILIZABLES
   ========================================== */
.btn-primary {
    padding: 10px 20px;
    background-color: var(--primary-color);
    color: white;
    border: none;
    border-radius: 20px; 
    cursor: pointer;
    font-weight: bold;
    font-size: 0.95rem;
    transition: background-color 0.2s;
}

.btn-primary:hover {
    background-color: var(--primary-hover);
}

.main-footer {
    background-color: var(--card-bg);
    text-align: center;
    padding: 1rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    border-top: 1px solid #334155;
    flex-shrink: 0; 
}

/* ==========================================
   MEDIA QUERIES (RESPONSIVE SIN IMPORTANT)
   ========================================== */

/* Computadoras y Pantallas Grandes (Mayor a 600px) */
@media (min-width: 600px) {
    /* Ensanchamos la grilla de la home a 4 columnas seguidas en PC */
    .home-section .characters-grid-responsive {
        grid-template-columns: repeat(4, 1fr);
    }
}

@media (min-width: 768px) {
    .chat-container {
        max-width: 700px;
        height: 70vh;
        margin: 20px auto;
    }
}
