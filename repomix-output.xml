        font-size: 1rem; 
        padding: 4px 6px;
    }
    
    .home-section .characters-grid-responsive {
        grid-template-columns: repeat(2, 1fr);
        gap: 16px; 
        max-width: 580px; 
    }
    
    .clickable-card {
        padding: 18px;
    }
    
    .clickable-card img {
        width: 80px; 
